# ---- Database -------------------------------------------------------------
# Local dev (SQLite): file:./dev.db      Production: a Postgres connection URL
DATABASE_URL="file:./dev.db"

# ---- Auth.js --------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Google:  https://console.cloud.google.com/apis/credentials
#          Authorised redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub:  https://github.com/settings/developers  (New OAuth App)
#          Authorisation callback URL: {AUTH_URL}/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ---- Agents ---------------------------------------------------------------
# Server-side key. Every agent invocation in the workspace uses this.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# Encrypts runner tokens at rest. openssl rand -hex 32
ENCRYPTION_KEY=""

# ---- Demo access -----------------------------------------------------------
# Opens a SHARED demo workspace from the login page, so a fresh deployment is
# usable before any OAuth client exists. Everyone who signs in this way lands in
# the same workspace. Leave unset (or "false") once real sign-in is configured.
ALLOW_DEMO_LOGIN="false"

# ---- Atlassian Cloud -------------------------------------------------------
# Jira: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL="https://your-site.atlassian.net"
JIRA_EMAIL=""
JIRA_API_TOKEN=""

# Xray Cloud: Jira → Apps → Xray → API Keys
XRAY_BASE_URL="https://xray.cloud.getxray.app"
XRAY_CLIENT_ID=""
XRAY_CLIENT_SECRET=""

# Bitbucket Cloud: Personal settings → App passwords
# Scopes needed: repository:read, repository:write, pullrequest:write
BITBUCKET_USERNAME=""
BITBUCKET_APP_PASSWORD=""
