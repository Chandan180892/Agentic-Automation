# Gantry configuration. Every value is validated at boot (src/lib/env.ts); in production an unsafe
# value stops the server with a message naming it. See docs/OPERATIONS.md for the full guide.

# ---- Database (required) -------------------------------------------------
# Postgres 14+. Locally: `npm run db:up` starts one from docker-compose.yml with these credentials.
DATABASE_URL="postgresql://gantry:gantry@localhost:5432/gantry"

# ---- Auth.js (required in production) --------------------------------------
# At least 32 characters: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Google:  https://console.cloud.google.com/apis/credentials
#          Authorised redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub:  https://github.com/settings/developers  (New OAuth App)
#          Authorisation callback URL: {AUTH_URL}/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Opens a SHARED demo workspace from the login page. Off unless "true". Turn it off in production
# once OAuth is configured — the server logs a warning at every boot while it is on.
ALLOW_DEMO_LOGIN=""

# ---- Agents -----------------------------------------------------------------
# Without a key every agent runs on its deterministic simulator, labelled as such in the UI.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
# Per model request, in ms; the SDK retries 408/409/429/5xx and dropped connections.
MODEL_TIMEOUT_MS="120000"
MODEL_MAX_RETRIES="3"
# Input + output tokens one workspace may spend per UTC day. 0 removes the cap.
AGENT_DAILY_TOKEN_BUDGET="3000000"

# ---- Jobs -------------------------------------------------------------------
# "inline": the web server also runs the job worker (one deployable).
# "off":    run workers separately (`npm run worker`, or the same image with WORKER_MODE=inline
#           and no traffic) — scale agent work independently of web traffic.
WORKER_MODE="inline"
WORKER_CONCURRENCY="2"
# A job whose worker stops heartbeating for this long is failed as interrupted.
JOB_LEASE_MS="60000"
# Log lines and finished jobs older than this are deleted hourly. 0 keeps everything.
EVENT_RETENTION_DAYS="30"
# Agent-starting actions allowed per workspace per minute.
ACTION_RATE_LIMIT_PER_MINUTE="10"

# ---- Autopilot --------------------------------------------------------------
# Pause between steps in ms. Defaults to 450 on the simulator (so a cycle can be watched), 0 live.
AUTOPILOT_PACE_MS=""
# Upper bound for "Run until stable" (2–10, default 5).
AUTOPILOT_MAX_CYCLES=""

# ---- Observability ----------------------------------------------------------
# debug | info | warn | error. Production logs are one JSON object per line.
LOG_LEVEL="info"

# ---- Atlassian (credentials here; project keys and repo in Settings) ---------
JIRA_BASE_URL=""
JIRA_EMAIL=""
JIRA_API_TOKEN=""
XRAY_CLIENT_ID=""
XRAY_CLIENT_SECRET=""
BITBUCKET_USERNAME=""
BITBUCKET_APP_PASSWORD=""
