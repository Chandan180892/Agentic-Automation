// Gantry — agentic QE automation.
// Default provider is sqlite so a fresh clone runs with zero setup.
// For Postgres: `npm run db:postgres` (rewrites the provider below), then set
// DATABASE_URL to your Postgres connection string.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- Auth.js --

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime     @default(now())
  accounts      Account[]
  sessions      Session[]
  memberships   Membership[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// -------------------------------------------------------------- Workspace --

model Workspace {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  createdAt DateTime     @default(now())
  members   Membership[]
  sprints   Sprint[]
  runs      Run[]

  // Atlassian Cloud wiring. Credentials live in env; these are the coordinates.
  jiraProjectKey      String @default("")
  xrayProjectKey      String @default("")
  bitbucketWorkspace  String @default("")
  bitbucketRepo       String @default("")
  defaultBranch       String @default("main")
  testFramework       String @default("playwright")
}

model Membership {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        String    @default("owner") // owner | admin | member
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

// ----------------------------------------------------------------- Sprint --

model Sprint {
  id             String    @id @default(cuid())
  workspaceId    String
  name           String
  goal           String?
  startsAt       DateTime
  endsAt         DateTime
  capacityPoints Int       @default(30)
  status         String    @default("planning") // planning | active | closed
  planJson       String? // sprint-planner proposal, JSON
  createdAt      DateTime  @default(now())
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stories        Story[]
  runs           Run[]
}

model Story {
  id                 String   @id @default(cuid())
  sprintId           String
  key                String // the Jira issue key, e.g. PAY-812
  jiraId             String   @default("")
  jiraUrl            String   @default("")
  issueType          String   @default("Story")
  title              String
  description        String   @default("")
  acceptanceCriteria String   @default("[]") // JSON array of strings
  points             Int?
  priority           Int      @default(0)
  status             String   @default("todo") // todo | specced | running | green | failing
  tagsJson           String   @default("[]")
  committed          Boolean  @default(true)
  createdAt          DateTime @default(now())
  sprint             Sprint     @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  testCases          TestCase[]
  runs               Run[]

  @@unique([sprintId, key])
}

// -------------------------------------------------------- Agents & running --

model Run {
  id          String    @id @default(cuid())
  workspaceId String
  sprintId    String?
  storyId     String?
  agent       String // qe-pipeline | sprint-planner | qe-auto-heal | batch-heal | qe-insights
  mode        String    @default("single") // single | batch
  status      String    @default("queued") // queued | running | succeeded | failed | needs_review | blocked
  inputJson   String    @default("{}")
  outputJson  String?
  error       String?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sprint      Sprint?   @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  story       Story?    @relation(fields: [storyId], references: [id], onDelete: SetNull)
  stages      Stage[]
  events      Event[]
  assets      Asset[]
  testCases   TestCase[]
  publications Publication[]

  @@index([workspaceId, startedAt])
}

/// One sub-agent's turn inside a pipeline run. The chain is ordered, and a stage that
/// blocks stops the ones after it rather than letting a guess flow downstream.
model Stage {
  id         String    @id @default(cuid())
  runId      String
  agent      String // story-analyzer | clarify | asset-resolver | spec-author | verifier | reviewer
  order      Int
  status     String    @default("pending") // pending | running | passed | blocked | failed | skipped
  summary    String    @default("")
  outputJson String?
  startedAt  DateTime?
  finishedAt DateTime?
  run        Run       @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, order])
}

/// An Xray test case the pipeline proposes for a story.
model TestCase {
  id           String   @id @default(cuid())
  runId        String
  storyId      String?
  summary      String
  testType     String   @default("Manual") // Manual | Cucumber | Generic
  priority     String   @default("Medium")
  stepsJson    String   @default("[]") // [{action, data, expected}]
  gherkin      String   @default("")
  labelsJson   String   @default("[]")
  criterion    String   @default("") // the acceptance criterion it covers
  xrayKey      String   @default("") // filled in once published
  published    Boolean  @default(false)
  createdAt    DateTime @default(now())
  run          Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  story        Story?   @relation(fields: [storyId], references: [id], onDelete: SetNull)
}

/// What the pipeline wants to write to Jira, Xray or Bitbucket. Nothing leaves Gantry
/// until someone approves the publication here.
model Publication {
  id          String    @id @default(cuid())
  runId       String
  target      String // jira-comment | xray-tests | bitbucket-branch
  status      String    @default("proposed") // proposed | approved | published | failed
  payloadJson String    @default("{}")
  resultJson  String?
  error       String?
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  run         Run       @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model Asset {
  id        String   @id @default(cuid())
  runId     String
  path      String
  kind      String // spec | fixture | pageobject | data | report | patch
  content   String
  reused    Boolean  @default(false) // asset-resolver found it already in the repo
  bytes     Int      @default(0)
  createdAt DateTime @default(now())
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model Event {
  id      String   @id @default(cuid())
  runId   String
  stage   String   @default("")
  ts      DateTime @default(now())
  level   String   @default("info") // info | ok | warn | error
  source  String   @default("system")
  message String
  run     Run      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, ts])
}
